# ---- Timezone
TZ="Etc/UTC"

# ---- MySQL Setup

# Database user / pass for homer.
DB_USER=homer_user
DB_PASS=homer_password

# The Homer docker setup, by default, uses its own MySQL running in it's own container, locally.
# If you'd rather use a different server, set USE_REMOTE_MYSQL=true
# and set DB_HOST to the hostname or IP address of your MySQL server (not "mysql").
# Use docker-compose -f docker-compose.yml -f docker-compose.external-mysql.yml up
USE_REMOTE_MYSQL=false
DB_HOST=mysql

# This allows to set up a port different than the default one
DB_PORT=3306

# Root password for mysql (if a local instance)
MYSQL_ROOT_PASSWORD=secret

# ----- HEP Listen port.
KAMAILIO_HEP_PORT=9060
